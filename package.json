{
  "name": "slither-client",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Development tools for the independent Rust/Wasm client prototypes",
  "scripts": {
    "test": "node --test tools/*.test.mjs",
    "build:web": "node tools/build-web.mjs",
    "build:extension": "node tools/build-extension.mjs",
    "prototype": "node tools/prototype-server.mjs",
    "scene": "node tools/scene-server.mjs",
    "compare:reference": "node tools/reference-parity.mjs",
    "browser:regression": "node tools/browser-run.mjs",
    "browser:performance": "node tools/browser-run.mjs --mode performance",
    "browser:reference": "node tools/browser-reference.mjs",
    "browser:scenario": "node tools/browser-scenario.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "ws": "8.22.0"
  }
}
