{
  "manifest_version": 3,
  "name": "SlitherClient",
  "version": "0.1.0",
  "version_name": "0.1.0-alpha.0",
  "description": "Explicit game-page Rust/Wasm bootstrap and offline preview. Optional pinned same-origin profile acquisition for Play.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "SlitherClient",
    "default_popup": "launcher.html"
  },
  "web_accessible_resources": [{
    "matches": ["http://slither.io/*", "https://slither.io/*", "http://www.slither.io/*", "https://www.slither.io/*"],
    "resources": ["game/bootstrap.mjs", "game/runtime.mjs", "game/owned-hud-ui.mjs", "game/owned-play-ui.mjs", "game/owned-appearance-ui.mjs", "game/appearance-preview.mjs", "game/game-owned-loading-ui.mjs", "game/start-page-layout.mjs", "assets/logo.svg", "game/owned-leaderboard-ui.mjs", "game/owned-minimap-ui.mjs", "game/owned-end-screen-ui.mjs", "game/owned-announcement-ui.mjs", "game/stock-host-snapshot.mjs", "game/stock-client.mjs", "game/stock-skin-provider.mjs", "game/stock-skin-rules.mjs", "game/stock-accessory-selection.mjs", "game/stock-cached-accessory.mjs", "game/stock-accessory-load.mjs", "game/stock-accessory-request.mjs", "game/skin-provider.mjs", "game/stock-food-provider.mjs", "game/stock-prey-provider.mjs", "game/stock-asset-sources.mjs", "game/desktop-layout.mjs", "game/client-input.mjs", "game/stock-gameplay.mjs", "game/stock-session.mjs", "game/stock-hud-contract.mjs", "game/stock-hud-state.mjs", "game/stock-hud-view.mjs", "game/stock-hud-dom.mjs", "game/handshake-session.mjs", "game/stock-live-profile.mjs", "game/stock-leaderboard-state.mjs", "game/stock-leaderboard-view.mjs", "game/local-game-host.mjs", "game/client-asset-map.mjs", "game/authored-source-recipes.mjs", "game/synthetic-body.mjs", "game/synthetic-food.mjs", "game/synthetic-prey.mjs", "game/loopback-session.mjs", "game/pkg/slither_client.js", "game/pkg/slither_client_bg.wasm"]
  }],
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
  }
}
